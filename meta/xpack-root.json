  "description": "Root components",
  "cdlComponents": [
    {
      "id": "micro-os-plus",
      "description": "The top µOS++ node",
      "cdlInterfaces": [
        {
          "id": "architecture",
          "description": "The generic architecture, to guarantee a single implementation",
          "customDefine": "$MICRO_OS_PLUS_INCLUDE_ARCHITECTURE"
