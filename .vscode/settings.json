{
  "editor.rulers": [
    80
  ],
  "cSpell.ignoreWords": [
    "Ionescu",
    "Liviu",
    "POSIX",
    "RANLIB",
    "Wmismatched",
    "Wpedantic",
    "aarch",
    "buildtype",
    "cleanup",
    "cmake",
    "cmsis",
    "compat",
    "cortexm",
    "ctest",
    "eabi",
    "libgcc",
    "libstdc",
    "minsize",
    "mkdir",
    "newlib",
    "npmignore",
    "npmjs",
    "postversion",
    "riscv",
    "semihosting",
    "subdir",
    "xpack",
    "xpacks"
  ],
  "cmake.ignoreCMakeListsMissing": true,
  "cmake.configureOnOpen": false,
  "[cmake]": {
    "editor.defaultFormatter": "cheshirekow.cmake-format",
    "editor.formatOnSave": false
  },
  "cmakeFormat.args": [
    "--dangle-parens",
    "--separate-ctrl-name-with-space",
    "--separate-fn-name-with-space"
  ],
  "makefile.configureOnOpen": false,
  "editor.wordWrap": "on",
  "mesonbuild.selectRootDir": false
}