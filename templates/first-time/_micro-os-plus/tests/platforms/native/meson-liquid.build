# Create the platform specific test executables.

# -----------------------------------------------------------------------------

message('Processing tests/platforms/native...')

# -----------------------------------------------------------------------------

# https://mesonbuild.com/Unit-tests.html#malloc_perturb_
xpack_environment = environment()
xpack_environment.set('MALLOC_PERTURB_', '0')
{% if packageScopedName == '@micro-os-plus/micro-test-plus' %}
# -----------------------------------------------------------------------------

if xpack_enable_empty_test

  # https://mesonbuild.com/Reference-manual_functions.html#test
  test(
    'empty-test --verbose',
    empty_test,
    args: [
      'one',
      'two',
      '--verbose'
    ],
    env: xpack_environment
  )

  test(
    'empty-test',
    empty_test,
    args: [
      'one',
      'two'
    ],
    env: xpack_environment
  )

endif

# -----------------------------------------------------------------------------

if xpack_enable_minimal_test

  # https://mesonbuild.com/Reference-manual_functions.html#test
  test(
    'minimal-test --verbose',
    minimal_test,
    args: [
      'one',
      'two',
      '--verbose'
    ],
    env: xpack_environment
  )

  test(
    'minimal-test',
    minimal_test,
    args: [
      'one',
      'two'
    ],
    env: xpack_environment
  )

  test(
    'minimal-test --quiet',
    minimal_test,
    args: [
      'one',
      'two',
      '--quiet'
    ],
    env: xpack_environment
  )

  test(
    'minimal-test --silent',
    minimal_test,
    args: [
      'one',
      'two',
      '--silent'
    ],
    env: xpack_environment
  )

endif

# -----------------------------------------------------------------------------

if xpack_enable_suite_test

  # https://mesonbuild.com/Reference-manual_functions.html#test
  test(
    'suite-test --verbose',
    suite_test,
    args: [
      'one',
      'two',
      '--verbose'
    ],
    env: xpack_environment
  )

  test(
    'suite-test',
    suite_test,
    args: [
      'one',
      'two'
    ],
    env: xpack_environment
  )

  test(
    'suite-test --quiet',
    suite_test,
    args: [
      'one',
      'two',
      '--quiet'
    ],
    env: xpack_environment
  )

  test(
    'suite-test --silent',
    suite_test,
    args: [
      'one',
      'two',
      '--silent'
    ],
    env: xpack_environment
  )

endif
{% endif %}
# -----------------------------------------------------------------------------

if xpack_enable_sample_test

  # https://mesonbuild.com/Reference-manual_functions.html#test
  test(
    'sample-test',
    sample_test,
    args: [
      'one',
      'two'
    ],
    env: xpack_environment
  )
{%- if packageScopedName == '@micro-os-plus/micro-test-plus' %}

  # https://mesonbuild.com/Reference-manual_functions.html#test
  test(
    'sample-test',
    sample_test,
    args: [
      'one',
      'two',
      '--verbose'
    ],
    env: xpack_environment
  )

  test(
    'sample-test',
    sample_test,
    args: [
      'one',
      'two'
    ],
    env: xpack_environment
  )

  test(
    'sample-test',
    sample_test,
    args: [
      'one',
      'two',
      '--quiet'
    ],
    env: xpack_environment
  )

  test(
    'sample-test',
    sample_test,
    args: [
      'one',
      'two',
      '--silent'
    ],
    env: xpack_environment
  )
{%- endif %}
endif

# -----------------------------------------------------------------------------

if xpack_enable_unit_test

  # https://mesonbuild.com/Reference-manual_functions.html#test
  test(
    'unit-test',
    unit_test,
    args: ['--reporter', 'human'],
    env: xpack_environment
  )
{%- if packageScopedName == '@micro-os-plus/micro-test-plus' %}

  test(
    'unit-test',
    unit_test,
    args: ['--verbose', '--reporter', 'human'],
    env: xpack_environment
  )

  test(
    'unit-test',
    unit_test,
    args: ['--quiet', '--reporter', 'human'],
    env: xpack_environment
  )

  test(
    'unit-test',
    unit_test,
    args: ['--silent', '--reporter', 'human'],
    env: xpack_environment
  )
{%- endif %}
