  # Native tests do not need size, list, hex targets.
  # ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

  # https://mesonbuild.com/Reference-manual_functions.html#test
  test(
    'unit-test',
    unit_test,
    args: [],
