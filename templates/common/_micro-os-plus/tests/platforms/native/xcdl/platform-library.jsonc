{
  // DO NOT EDIT!
  // Automatically generated from build-helper/templates.
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Liviu Ionescu. All rights reserved.",
  "properties": {},
  "cdlComponents": [
    {
      "id": "native",
      "display": "Native Platform",
      "description": "Runs an µOS++ application as a native process on the host (GNU/Linux, macOS, Windows)",
      "publicIncludeFolders": [
        "include"
      ],
      "sourceFiles": [],
      // For full POSIX conformance, C programs shall define _POSIX_C_SOURCE 
      // to be 200809L before any header is included:
      // https://pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap02.html#tag_02_01_03
      "publicDefines": [
        "_POSIX_C_SOURCE=200809L"
      ],
      // Apple clang 13 does not support -Wunused-but-set-variable.
      "publicCompilerOptions": {
        "warnings": [
          "-Werror",
          "{% if compiler.dialect == 'clang' %}-Wno-unknown-warning-option{% endif %}",
          "{% if compiler.dialect == 'clang' %}-Wno-documentation{% endif %}"
        ],
        "optimisations": [
          "{% if buildType == 'release' or buildType == 'minSize' %}-flto{% endif %}"
        ],
        "linker": [
          "{% if compiler.dialect == 'clang' %}-rtlib=compiler-rt{% endif %}",
        ]
      },
      "implements": [
        "micro-os-plus.platform"
      ],
      "dependencies": [
        "micro-os-plus.device"
      ],
      // "defaultDefine": "{{properties.platformDefine}}",
      "cdlOptions": [
        {
          "id": "win32",
          "display": "Windows",
          "description": "Compiler options for Windows",
          "activeIf": [
            "os.platform === 'win32'"
          ],
          "configurable": false,
          "publicCompilerOptions": {
            "warnings": [
              "{% if compiler.dialect == 'clang' %}-Wno-missing-include-dirs{% endif %}"
            ],
            "linker": [
              "-static",
              "-Wl,--gc-sections"
            ]
          }
        },
        {
          "id": "darwin",
          "display": "macOS",
          "description": "Compiler options for macOS",
          "activeIf": [
            "os.platform === 'darwin'"
          ],
          "configurable": false,
          "publicCompilerOptions": {
            "warnings": [
              "-Wno-missing-include-dirs"
            ],
            "miscellaneous": [
              "{% if compiler.dialect == 'gnu' %}-no-pie{% endif %}"
            ],
            "linker": [
              "-Wl,-dead_strip",
              "{% if compiler.dialect == 'clang' %}-fuse-ld=lld{% endif %}",
              "{{rpathOptionsList}}"
            ]
          }
        },
        {
          "id": "linux",
          "display": "GNU/Linux",
          "description": "Compiler options for GNU/Linux",
          "activeIf": [
            "os.platform === 'linux'"
          ],
          "configurable": false,
          "publicCompilerOptions": {
            "warnings": [],
            "linker": [
              "-Wl,--gc-sections",
              "{% if compiler.dialect == 'clang' %}-lunwind{% endif %}",
              "{% if compiler.dialect == 'clang' %}-fuse-ld=lld{% endif %}",
              "{{rpathOptionsList}}"
            ]
          }
        }
      ]
    }
  ]
}